---
import { SITE_NAME, SOCIAL_LINKS } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-[800px] px-6 pb-12 pt-4 font-label text-sm text-on-surface-variant">
	<div class="border-t border-outline-variant/25 pt-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<p>© {year} {SITE_NAME}</p>
			<nav aria-label="Social links">
				<ul class="flex flex-wrap gap-x-5 gap-y-2">
					{
						SOCIAL_LINKS.map((link) => (
							<li>
								<a
									class="inline-flex items-baseline gap-1 text-primary underline-offset-4 hover:underline"
									href={link.href}
									target="_blank"
									rel="noreferrer"
								>
									{link.label}
									<span aria-hidden="true">↗</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</footer>
