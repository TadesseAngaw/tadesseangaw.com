---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPostDate, getPublishedPosts } from "../lib/blog";

const posts = (await getPublishedPosts()).slice(0, 8);
const homeTitle = "Tadesse Angaw";
const homeIntro = "I build software, lead teams, and write about the lessons that stay with me.";
---

<BaseLayout title="Home" description={homeIntro}>
	<header class="mb-20">
		<h1
			class="font-headline mb-6 text-[3.5rem] font-extrabold leading-[1.1] tracking-tighter text-on-surface"
		>
			{homeTitle}
		</h1>
		<p class="max-w-[600px] font-body text-xl leading-relaxed text-on-surface-variant">
			{homeIntro}
		</p>
	</header>

	<section class="mb-24" aria-labelledby="blog-heading">
		<h2
			id="blog-heading"
			class="font-label mb-10 text-sm uppercase tracking-widest text-on-surface-variant"
		>
			Blog
		</h2>
		{
			posts.length === 0 ? (
				<p class="font-body text-lg text-on-surface-variant">
					No published posts yet. Add Markdown files under{" "}
					<code class="font-mono text-sm">src/content/blog</code>.
				</p>
			) : (
				<ul class="space-y-12">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.data.slug}`} class="group block">
								<h3 class="font-headline text-2xl font-bold tracking-tight text-on-surface group-hover:text-primary">
									{post.data.title}
								</h3>
								<time
									class="font-label mt-2 block text-sm text-on-surface-variant"
									datetime={post.data.publishedAt.toISOString()}
								>
									{formatPostDate(post.data.publishedAt)}
								</time>
								{post.data.excerpt ? (
									<p class="mt-3 max-w-prose font-body text-lg leading-relaxed text-on-surface-variant">
										{post.data.excerpt}
									</p>
								) : null}
							</a>
						</li>
					))}
				</ul>
			)
		}
		<p class="mt-12 font-label text-sm">
			<a class="text-primary underline-offset-4 hover:underline" href="/blog"
				>View all blog posts →</a
			>
		</p>
	</section>

	<hr class="mx-auto mb-24 w-[60%] border-0 border-t border-outline-variant/15" />

	<section class="mb-24 grid gap-16 md:grid-cols-2" aria-labelledby="more-heading">
		<h2 id="more-heading" class="sr-only">More about Tadesse</h2>
		<div>
			<h3 class="font-label mb-8 text-sm uppercase tracking-widest text-on-surface-variant">
				Portfolio
			</h3>
			<p class="text-on-surface-variant">
				A focused view of the engineering work, strengths, and problems I care about.
			</p>
			<p class="mt-8 font-label text-sm">
				<a class="text-primary underline-offset-4 hover:underline" href="/portfolio">Portfolio →</a>
			</p>
		</div>
		<div>
			<h3 class="font-label mb-8 text-sm uppercase tracking-widest text-on-surface-variant">CV</h3>
			<p class="text-on-surface-variant">
				A concise professional record for roles, projects, and experience.
			</p>
			<p class="mt-8 font-label text-sm">
				<a class="text-primary underline-offset-4 hover:underline" href="/cv">CV →</a>
			</p>
		</div>
	</section>
</BaseLayout>
