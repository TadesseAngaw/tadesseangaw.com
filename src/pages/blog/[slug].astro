---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { formatPostDate, getPublishedPosts, type BlogPost } from "../../lib/blog";

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.data.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
---

<BaseLayout
	title={post.data.title}
	description={post.data.excerpt}
	image={post.data.heroImage}
	imageAlt={post.data.heroImageAlt}
	type="article"
>
	<article>
		<header class="mb-10">
			<h1
				class="font-headline text-[2.75rem] font-extrabold leading-tight tracking-tight text-on-surface"
			>
				{post.data.title}
			</h1>
			<div
				class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-label text-sm text-on-surface-variant"
			>
				<time datetime={post.data.publishedAt.toISOString()}
					>Published on {formatPostDate(post.data.publishedAt)}</time
				>
				{
					post.data.tags.length > 0 ? (
						<div class="flex flex-wrap gap-2">
							{post.data.tags.map((tag) => (
								<a
									class="text-primary underline-offset-4 hover:underline"
									href={`/blog?tag=${encodeURIComponent(tag)}`}
								>
									#{tag}
								</a>
							))}
						</div>
					) : null
				}
			</div>
		</header>

		{
			post.data.heroImage ? (
				<figure class="mb-10 border-y border-outline-variant py-4">
					<img
						class="aspect-[1200/630] w-full object-cover"
						src={post.data.heroImage}
						alt={post.data.heroImageAlt ?? ""}
					/>
					{post.data.heroImageCreditName ? (
						<figcaption class="mt-3 font-label text-xs leading-relaxed text-on-surface-variant">
							{post.data.heroImageSourceUrl ? (
								<>
									Photo credit:{" "}
									<a
										class="inline-flex items-baseline gap-1 text-primary underline-offset-4 hover:underline"
										href={post.data.heroImageSourceUrl}
										target="_blank"
										rel="noreferrer"
									>
										{post.data.heroImageCreditName}
										<span aria-hidden="true">↗</span>
									</a>
									.
								</>
							) : null}
							{post.data.heroImageLicenseUrl ? (
								<>
									{" "}
									<a
										class="inline-flex items-baseline gap-1 text-primary underline-offset-4 hover:underline"
										href={post.data.heroImageLicenseUrl}
										target="_blank"
										rel="noreferrer"
									>
										{post.data.heroImageLicenseName ?? "License"}
										<span aria-hidden="true">↗</span>
									</a>
								</>
							) : null}
						</figcaption>
					) : null}
				</figure>
			) : null
		}

		<div
			class="prose-engineering max-w-none font-body text-lg leading-[1.75] text-on-surface [&_a]:text-primary [&_code]:bg-surface-container-highest [&_code]:px-1 [&_pre]:bg-surface-container-highest [&_pre]:p-4"
		>
			<Content />
		</div>

		<footer class="mt-16 font-label text-sm">
			<a class="text-tertiary underline-offset-4 hover:underline" href="/blog">← Back to blog</a>
		</footer>
	</article>
</BaseLayout>

<style is:global>
	.prose-engineering h2,
	.prose-engineering h3 {
		font-family: var(--font-headline);
		font-weight: 700;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
	}

	.prose-engineering p {
		margin-bottom: 1rem;
	}

	.prose-engineering hr {
		border: 0;
		border-top: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
		margin: 3rem 0 2rem;
	}

	.prose-engineering .data-footnote-backref {
		font-family: var(--font-label);
		font-size: 0.85em;
		margin-left: 0.25rem;
		text-decoration: none;
	}

	.prose-engineering sup a {
		font-family: var(--font-label);
		text-decoration: none;
	}
</style>
